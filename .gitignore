# ---- Flutter / Dart ----
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/.pub-cache/
flutter_app/.pub/
build/
.dart_tool/

# pubspec.lock IS tracked on purpose: this is an application, not a
# package library, so the resolved dependency set must be reproducible.
# Do not add it here.

# ---- Editors / OS ----
.idea/
*.iml
.vscode/
.DS_Store

# ---- Claude Code local state ----
.claude/settings.local.json

# ---- graphify code graph ----
# The graph is a rebuildable artifact (`graphify update .`), and graph.json
# runs to several MB. The .graphifyignore that scopes it IS tracked.
graphify-out/

# ---- Generated report samples (regenerate via report export flows) ----
output/

# ---- Local secrets and per-machine config (never commit) ----
# The Google OAuth notes hold a client secret; resend.md holds an API key.
# env/*.json carries real ids for --dart-define-from-file; only the
# *.example.json placeholders are tracked.
google_clients.md
google_auth.md
resend.md
flutter_app/env/*.json
!flutter_app/env/*.example.json
